{
  "_source": "https://cohere.com",
  "_note": "Design tokens read verbatim from cohere.com production CSS (2026-06-05). Translated onto MAOS — proprietary fonts substituted with public Space Grotesk / Inter that carry the same grotesque feel.",
  "palette": {
    "canvas": "#fafafa",
    "surface": "#ffffff",
    "ink": "#17171c",
    "ink-soft": "#212121",
    "ink-mute": "#616161",
    "hairline": "#e0e0e0",
    "accent": "#ff7759",
    "accent-soft": "#ffd9d0",
    "accent-deep": "#ca492d",
    "orb-coral": "#ff7759",
    "orb-purple": "#d18ee2",
    "orb-blue": "#4c6ee6",
    "orb-blue-light": "#8fa6f9",
    "orb-violet": "#7670c5",
    "sand": "#d7cfc1",
    "lime": "#e8ff85",
    "dark-surface": "#101010"
  },
  "type": {
    "font-display": "Space Grotesk, Inter, ui-sans-serif, system-ui, sans-serif",
    "font-body": "Inter, ui-sans-serif, system-ui, sans-serif",
    "font-mono": "ui-monospace, SFMono-Regular, Menlo, monospace",
    "hero-size": "clamp(1rem, 10vw + 1rem, 10rem)",
    "scale-px": [12, 14, 16, 18, 20, 22, 24, 28, 32, 36, 48, 63, 90],
    "weight-regular": 400,
    "weight-display": 450,
    "weight-text": 500,
    "tracking-tight": "-0.02em",
    "tracking-label": "0.08em",
    "body-line-height": "24px"
  },
  "radius": {
    "sm": "8px",
    "md": "16px",
    "lg": "22px",
    "xl": "32px",
    "pill": "9999px"
  },
  "layout": {
    "container-max": "1440px",
    "section-pad": "120px",
    "nav-height": "64px"
  },
  "easing": {
    "standard": "cubic-bezier(.4,0,.2,1)",
    "decelerate": "cubic-bezier(0,0,.2,1)",
    "accelerate": "cubic-bezier(.4,0,1,1)"
  }
}
